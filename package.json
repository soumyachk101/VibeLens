{
  "name": "mcp-vibelens",
  "version": "1.0.0",
  "description": "VibeLens \u2014 an MCP server that gives AI coding assistants eyes on localhost: screenshots, console errors, and a token-optimized DOM snapshot.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "ui-debugging",
    "screenshot",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "antigravity",
    "vibe-coding"
  ],
  "license": "MIT",
  "author": {
    "name": "Soumya Chakraborty",
    "url": "https://github.com/soumyachk101"
  },
  "homepage": "https://github.com/soumyachk101/VibeLens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soumyachk101/VibeLens.git"
  },
  "bugs": {
    "url": "https://github.com/soumyachk101/VibeLens/issues"
  },
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "mcp-vibelens": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "validate:plugin": "claude plugin validate . && claude plugin validate ./plugin",
    "assets:measure": "node scripts/assets/measure-dom.mjs",
    "assets:gif": "node scripts/assets/capture-demo.mjs && node scripts/assets/build-gif.mjs",
    "site:build": "node scripts/site/build.mjs",
    "site:check": "node scripts/site/check.mjs",
    "site:pages": "node scripts/site/build.mjs --base /VibeLens",
    "install:browser": "playwright install chromium",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright": "1.62.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "marked": "18.0.7",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
